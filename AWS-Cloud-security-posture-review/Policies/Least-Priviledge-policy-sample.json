{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApprovedEvidenceBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::velora-training-evidence-example"
    },
    {
      "Sid": "ReadApprovedEvidenceObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::velora-training-evidence-example/sanitized/*"
    }
  ]
}

